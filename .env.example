# Discord Bot Credentials
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Translation Engine Keys
DEEPL_AUTH_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Redis In-Memory Routing & Cache
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Optional MongoDB Storage (if used alongside SQLite)
MONGODB_URI=
MONGODB_DB_NAME=dc_translation
MONGODB_CERT_PEM=
MONGODB_CERT_PATH=

# AES-256 Master Encryption Secret (32-byte hex/base64 string)
ENCRYPTION_SECRET_KEY=

# Healthcheck HTTP Server Port
PORT=8080
