# Discord Application Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Translation Engine Keys
GOOGLE_TRANSLATE_API_KEY=
DEEPL_AUTH_KEY=

# AES-256-GCM Master Encryption Secret (Generate with: openssl rand -hex 32)
ENCRYPTION_SECRET_KEY=

# Optional MongoDB Atlas Storage (L2 Cache & Encrypted Persistence)
MONGODB_URI=
MONGODB_DB_NAME=dc_translation
MONGODB_CERT_PEM=
MONGODB_CERT_PATH=

# Optional Redis Cache & Routing
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Runtime & Healthcheck Server
NODE_ENV=production
PORT=8080
