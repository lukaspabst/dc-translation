# Discord Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Google Cloud Translation API (500,000 free chars/month)
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here
GCP_PROJECT_ID=your_gcp_project_id_here

# DeepL API Key (Optional, for on-demand enhancement button)
DEEPL_AUTH_KEY=your_deepl_api_key_here

# MongoDB Persistent Storage (Optional: if omitted, uses local encrypted SQLite)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dc_translation

# Field-Level AES-256-GCM Encryption Key (32-byte secret)
ENCRYPTION_SECRET_KEY=your-32-byte-master-encryption-secret-here
