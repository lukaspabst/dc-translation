{
  "name": "dc-translation",
  "version": "1.0.0",
  "description": "High-performance multilingual Discord translation bot with private live threads, AES-256-GCM field encryption, and multi-tier caching.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify-all.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "translation",
    "google-translate",
    "deepl",
    "typescript",
    "sqlite",
    "mongodb"
  ],
  "author": "zeN",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "deepl-node": "^1.27.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "google-translate-api-x": "^10.7.2",
    "ioredis": "^6.0.0",
    "languagedetect": "^2.0.0",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
